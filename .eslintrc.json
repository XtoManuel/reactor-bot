{
    "env": {
        "es2021": true,
        "node": true
    },
    "extends": ["xo", "prettier", "plugin:import/recommended", "plugin:editorconfig/noconflict"],
    "plugins": ["import", "editorconfig"],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "prefer-const": "error",
        "new-cap": "off",
        "no-undef": "warn",
        "camelcase": "off",
        "no-bitwise": "off",
        "import/first": "error",
        "import/no-duplicates": "error",
        "no-duplicate-imports": "error",
        "no-implicit-coercion": "off",
        "capitalized-comments": "off",
        "guard-for-in": "off",
        "no-unused-vars": "warn",
        "no-unused-labels": "warn",
        "no-unused-expressions": "warn",
        "no-use-before-define": "warn",
        "no-import-assign": "warn",
        "no-func-assign": "warn",
        "no-unused-modules": "warn"
    }
}
